# Copy to android/keystore.properties (never commit the real file).
# Create upload keystore once:
#   keytool -genkey -v -keystore restorebraine-upload.keystore -alias restorebraine -keyalg RSA -keysize 2048 -validity 10000
storeFile=../restorebraine-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=restorebraine
keyPassword=YOUR_KEY_PASSWORD
